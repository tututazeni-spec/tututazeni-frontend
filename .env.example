# Destino interno (server-side) do proxy /api em dev e dos route handlers.
# NUNCA é exposto ao browser — o browser chama sempre /api relativo.
API_INTERNAL_URL=http://localhost:4000

# Hostnames https permitidos para imagens externas (separados por vírgula), ex.:
# storage.innova.ao. Vazio = qualquer https. Usado no build (next/image) e em
# runtime (img-src da CSP) — definir nos dois.
IMG_ALLOWED_HOSTS=
